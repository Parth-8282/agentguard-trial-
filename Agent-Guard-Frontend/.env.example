# PayShield Frontend Environment Configuration
# Target AgentGuard Backend URL
VITE_AGENTGUARD_API_URL=http://localhost:8000
VITE_AGENTGUARD_WS_URL=ws://localhost:8000

# MongoDB Database for Real Time Transactions
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?appName=Cluster0
PORT=3000

# Razorpay Integration Credentials (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
