# ==============================================================================
# PAYSHIELD + AGENTGUARD + KAFKA + REDIS: ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend AgentGuard Port & API
AGENTGUARD_API_URL=http://localhost:8000
VITE_AGENTGUARD_API_URL=http://localhost:8000
VITE_AGENTGUARD_WS_URL=ws://localhost:8000

# Apache Kafka Event Backbone
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKERS=localhost:9092

# Redis High-Speed Real-Time State & Velocity Window Store
REDIS_URL=redis://localhost:6379/0

# Persistent Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?appName=Cluster0

# Razorpay Integration Credentials (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI / Google Gemini Explainer Key
GEMINI_API_KEY=your_gemini_api_key
AG_GEMINI_MODEL=gemini-3.8-flash

# Developer mode (0 = Production, 1 = Dev/Demo)
AG_DEV=0
PORT=3000
